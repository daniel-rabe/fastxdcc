{
  "name": "fastxdcc",
  "version": "0.2.0",
  "description": "IRC client for XDCC downloads, with a desktop GUI and a terminal UI",
  "type": "module",
  "bin": {
    "fastxdcc": "./dist/index.js"
  },
  "main": "dist-gui/electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "gui": "npm run build:gui && electron .",
    "gui:dev": "node scripts/build-gui.mjs --dev && electron .",
    "gui:watch": "node scripts/build-gui.mjs --watch",
    "build:gui": "node scripts/build-gui.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json && tsc -p tsconfig.renderer.json",
    "gui:preview": "node scripts/build-gui.mjs && node scripts/preview-gui.mjs",
    "gui:serve": "node scripts/build-gui.mjs && node scripts/preview-gui.mjs && node scripts/serve-preview.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run build:gui && electron-builder --dir",
    "dist": "npm run build:gui && electron-builder"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  },
  "author": "fastxdcc"
}
